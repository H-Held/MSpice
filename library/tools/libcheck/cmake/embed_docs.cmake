#
# Generates a C++ source file that embeds every docs/errors/<CODE>.md file.
# Usage: cmake -DDOCS_DIR=<dir> -DOUT=<file.cpp> -P embed_docs.cmake

file(GLOB docs "${DOCS_DIR}/*.md")
list(FILTER docs INCLUDE REGEX "/[EW][0-9][0-9][0-9][0-9][.]md$")
list(SORT docs)

set(body "// Generated by embed_docs.cmake. Do not edit.\n#include \"explain.hpp\"\n\nnamespace libcheck {\n\n")
set(table "")
set(count 0)
foreach(doc IN LISTS docs)
  get_filename_component(code "${doc}" NAME_WE)
  file(READ "${doc}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(APPEND body "static const unsigned char doc_${code}[] = {${hex}0x00};\n")
  string(APPEND table "    {\"${code}\", reinterpret_cast<const char*>(doc_${code})},\n")
  math(EXPR count "${count} + 1")
endforeach()

string(APPEND body "\nconst ExplainDoc kExplainDocs[] = {\n${table}    {nullptr, nullptr}};\n")
string(APPEND body "const std::size_t kExplainDocCount = ${count};\n\n}  // namespace libcheck\n")

if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL body)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${body}")
